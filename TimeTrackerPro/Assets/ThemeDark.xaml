<!--
  ThemeDark.xaml — overrides de paleta oscura para Aurora
  ========================================================
  Solo redefine Color/Brush. Los estilos de controles
  (botones, scrollbar, etc.) quedan en Theme.xaml.
  WPF usa el último diccionario de MergedDictionaries como
  fuente para DynamicResource, por eso este archivo tiene
  precedencia sobre Theme.xaml cuando se carga en modo oscuro.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Fondos oscuros ===================== -->
  <Color x:Key="BgColor">#1A1816</Color>
  <Color x:Key="BgElevColor">#222019</Color>
  <Color x:Key="BgTileColor">#2A2720</Color>
  <Color x:Key="BgInputColor">#1A1816</Color>
  <Color x:Key="HeaderColor">#0E0D0C</Color>
  <Color x:Key="SidebarColor">#1E1C17</Color>

  <!-- ===================== Texto oscuro ===================== -->
  <Color x:Key="FgPrimaryColor">#EDE7D9</Color>
  <Color x:Key="FgHeadingColor">#D5CFC2</Color>
  <Color x:Key="FgMutedColor">#8A8278</Color>
  <Color x:Key="FgFaintColor">#5A5650</Color>
  <Color x:Key="FgOnDarkColor">#EDE7D9</Color>
  <Color x:Key="FgOnDarkMutedColor">#6B655C</Color>
  <!-- FgOnAccentColor sin cambio: texto blanco sobre botón teal -->

  <!-- ===================== Bordes oscuros ===================== -->
  <Color x:Key="BorderColor">#3A3730</Color>
  <Color x:Key="BorderSoftColor">#2E2B26</Color>
  <Color x:Key="BorderStrongColor">#46433C</Color>
  <Color x:Key="BorderInputColor">#3A3730</Color>

  <!-- ===================== Accent teal (más brillante sobre fondo oscuro) ===================== -->
  <Color x:Key="AccentColor">#1E8CB8</Color>
  <Color x:Key="AccentHoverColor">#197DA6</Color>
  <Color x:Key="AccentSoftColor">#18384A</Color>
  <Color x:Key="AccentSubColor">#2A5870</Color>

  <!-- ===================== Live ámbar ===================== -->
  <Color x:Key="LiveSoftColor">#3A2410</Color>

  <!-- ===================== Estados ===================== -->
  <Color x:Key="SuccessColor">#7EBB4A</Color>
  <Color x:Key="DangerColor">#D45848</Color>
  <Color x:Key="DangerSoftColor">#3A1815</Color>
  <Color x:Key="WarnSoftColor">#3A2D0A</Color>

  <!-- ===================== Panel de edición ===================== -->
  <Color x:Key="EditPanelColor">#18384A</Color>
  <Color x:Key="EditBorderColor">#1E8CB8</Color>

  <!-- ===================== Hover tokens ===================== -->
  <Color x:Key="AccentSoftHoverColor">#1F4960</Color>
  <Color x:Key="DangerHoverColor">#C03A30</Color>
  <Color x:Key="BgHoverColor">#2E2A22</Color>

  <!-- ===================== Brushes ===================== -->
  <SolidColorBrush x:Key="BgBrush"          Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="BgElevBrush"      Color="{StaticResource BgElevColor}"/>
  <SolidColorBrush x:Key="BgTileBrush"      Color="{StaticResource BgTileColor}"/>
  <SolidColorBrush x:Key="BgInputBrush"     Color="{StaticResource BgInputColor}"/>
  <SolidColorBrush x:Key="HeaderBrush"      Color="{StaticResource HeaderColor}"/>
  <SolidColorBrush x:Key="SidebarBrush"     Color="{StaticResource SidebarColor}"/>

  <SolidColorBrush x:Key="FgPrimaryBrush"     Color="{StaticResource FgPrimaryColor}"/>
  <SolidColorBrush x:Key="FgHeadingBrush"     Color="{StaticResource FgHeadingColor}"/>
  <SolidColorBrush x:Key="FgMutedBrush"       Color="{StaticResource FgMutedColor}"/>
  <SolidColorBrush x:Key="FgFaintBrush"       Color="{StaticResource FgFaintColor}"/>
  <SolidColorBrush x:Key="FgOnDarkBrush"      Color="{StaticResource FgOnDarkColor}"/>
  <SolidColorBrush x:Key="FgOnDarkMutedBrush" Color="{StaticResource FgOnDarkMutedColor}"/>

  <SolidColorBrush x:Key="BorderColorBrush"   Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderSoftBrush"    Color="{StaticResource BorderSoftColor}"/>
  <SolidColorBrush x:Key="BorderStrongBrush"  Color="{StaticResource BorderStrongColor}"/>
  <SolidColorBrush x:Key="BorderInputBrush"   Color="{StaticResource BorderInputColor}"/>

  <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush"   Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush"    Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="AccentSubBrush"     Color="{StaticResource AccentSubColor}"/>

  <SolidColorBrush x:Key="LiveSoftBrush"      Color="{StaticResource LiveSoftColor}"/>

  <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DangerSoftBrush"    Color="{StaticResource DangerSoftColor}"/>
  <SolidColorBrush x:Key="WarnSoftBrush"      Color="{StaticResource WarnSoftColor}"/>

  <SolidColorBrush x:Key="EditPanelBrush"     Color="{StaticResource EditPanelColor}"/>
  <SolidColorBrush x:Key="EditBorderBrush"    Color="{StaticResource EditBorderColor}"/>

  <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="{StaticResource AccentSoftHoverColor}"/>
  <SolidColorBrush x:Key="DangerHoverBrush"     Color="{StaticResource DangerHoverColor}"/>
  <SolidColorBrush x:Key="BgHoverBrush"         Color="{StaticResource BgHoverColor}"/>

</ResourceDictionary>
