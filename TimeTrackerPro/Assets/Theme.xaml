<!--
  Theme.xaml — tokens del rediseño Aurora para TimeTracker Pro
  ============================================================
  Cambiando los valores Color/FontFamily de aquí cambia todo el
  aspecto de la app. No edites brushes directamente: solo los
  Color resources que están justo arriba.

  Convenciones:
    Bg…       fondos
    Fg…       textos / iconos
    Border…   bordes
    Accent…   acción primaria (teal)
    Live…     cronómetro en marcha (ámbar) — reservado para futuro
    Success / Danger / Warn   estados
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Tipografía ===================== -->
  <!-- Carga Space Grotesk desde Assets/Fonts. Los 4 pesos están
       en archivos sueltos para máxima compatibilidad. -->
  <FontFamily x:Key="UIFontFamily">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>
  <FontFamily x:Key="DisplayFontFamily">pack://application:,,,/Assets/Fonts/#Space Grotesk</FontFamily>

  <!-- ===================== Colores Aurora (claro) ===================== -->
  <!-- Fondos -->
  <Color x:Key="BgColor">#FBF7EC</Color>           <!-- canvas principal -->
  <Color x:Key="BgElevColor">#FBF7EC</Color>       <!-- tarjetas, paneles -->
  <Color x:Key="BgTileColor">#EDE7D7</Color>       <!-- KPI tiles, fondo suave -->
  <Color x:Key="BgInputColor">#FBF7EC</Color>      <!-- inputs -->
  <Color x:Key="HeaderColor">#1B1614</Color>       <!-- cabecera oscura -->
  <Color x:Key="SidebarColor">#ECE6D4</Color>      <!-- panel izquierdo -->

  <!-- Texto -->
  <Color x:Key="FgPrimaryColor">#1B1614</Color>    <!-- texto principal y títulos -->
  <Color x:Key="FgHeadingColor">#2E2725</Color>    <!-- títulos secundarios -->
  <Color x:Key="FgMutedColor">#6B645A</Color>      <!-- labels, descripciones -->
  <Color x:Key="FgFaintColor">#A39A8A</Color>      <!-- texto faint -->
  <Color x:Key="FgOnDarkColor">#FBF7EC</Color>     <!-- texto sobre cabecera -->
  <Color x:Key="FgOnDarkMutedColor">#978E80</Color><!-- texto secundario sobre cabecera -->
  <Color x:Key="FgOnAccentColor">#FBF7EC</Color>   <!-- texto sobre botón teal -->

  <!-- Bordes -->
  <Color x:Key="BorderColor">#DCD3BD</Color>       <!-- borde por defecto -->
  <Color x:Key="BorderSoftColor">#E5DEC9</Color>   <!-- borde suave, track de barra -->
  <Color x:Key="BorderStrongColor">#C5BBA1</Color>
  <Color x:Key="BorderInputColor">#BAB09A</Color>

  <!-- Accent (teal) — la acción primaria -->
  <Color x:Key="AccentColor">#146C94</Color>
  <Color x:Key="AccentHoverColor">#0E5577</Color>
  <Color x:Key="AccentSoftColor">#D2E6EF</Color>
  <Color x:Key="AccentSubColor">#7FB1C4</Color>    <!-- relleno suave para subsecciones -->

  <!-- Live (ámbar) — para futura distinción del cronómetro en marcha -->
  <Color x:Key="LiveColor">#E07A1F</Color>
  <Color x:Key="LiveSoftColor">#F9E2C9</Color>

  <!-- Estados -->
  <Color x:Key="SuccessColor">#5C7C2A</Color>
  <Color x:Key="DangerColor">#B83A2E</Color>
  <Color x:Key="DangerSoftColor">#F4DAD6</Color>
  <Color x:Key="WarnSoftColor">#F6E2A6</Color>

  <!-- Panel de edición (versión Aurora del antiguo "edit panel" azul) -->
  <Color x:Key="EditPanelColor">#D2E6EF</Color>    <!-- fondo del panel edit -->
  <Color x:Key="EditBorderColor">#146C94</Color>   <!-- borde del panel edit -->

  <!-- ===================== Brushes (lo que se usa en los XAML) ===================== -->
  <SolidColorBrush x:Key="BgBrush"          Color="{StaticResource BgColor}"/>
  <SolidColorBrush x:Key="BgElevBrush"      Color="{StaticResource BgElevColor}"/>
  <SolidColorBrush x:Key="BgTileBrush"      Color="{StaticResource BgTileColor}"/>
  <SolidColorBrush x:Key="BgInputBrush"     Color="{StaticResource BgInputColor}"/>
  <SolidColorBrush x:Key="HeaderBrush"      Color="{StaticResource HeaderColor}"/>
  <SolidColorBrush x:Key="SidebarBrush"     Color="{StaticResource SidebarColor}"/>

  <SolidColorBrush x:Key="FgPrimaryBrush"   Color="{StaticResource FgPrimaryColor}"/>
  <SolidColorBrush x:Key="FgHeadingBrush"   Color="{StaticResource FgHeadingColor}"/>
  <SolidColorBrush x:Key="FgMutedBrush"     Color="{StaticResource FgMutedColor}"/>
  <SolidColorBrush x:Key="FgFaintBrush"     Color="{StaticResource FgFaintColor}"/>
  <SolidColorBrush x:Key="FgOnDarkBrush"    Color="{StaticResource FgOnDarkColor}"/>
  <SolidColorBrush x:Key="FgOnDarkMutedBrush" Color="{StaticResource FgOnDarkMutedColor}"/>
  <SolidColorBrush x:Key="FgOnAccentBrush"  Color="{StaticResource FgOnAccentColor}"/>

  <SolidColorBrush x:Key="BorderColorBrush"      Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderSoftBrush"  Color="{StaticResource BorderSoftColor}"/>
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>
  <SolidColorBrush x:Key="BorderInputBrush" Color="{StaticResource BorderInputColor}"/>

  <SolidColorBrush x:Key="AccentBrush"      Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
  <SolidColorBrush x:Key="AccentSoftBrush"  Color="{StaticResource AccentSoftColor}"/>
  <SolidColorBrush x:Key="AccentSubBrush"   Color="{StaticResource AccentSubColor}"/>

  <SolidColorBrush x:Key="LiveBrush"        Color="{StaticResource LiveColor}"/>
  <SolidColorBrush x:Key="LiveSoftBrush"    Color="{StaticResource LiveSoftColor}"/>

  <SolidColorBrush x:Key="SuccessBrush"     Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="DangerBrush"      Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DangerSoftBrush"  Color="{StaticResource DangerSoftColor}"/>
  <SolidColorBrush x:Key="WarnSoftBrush"    Color="{StaticResource WarnSoftColor}"/>

  <SolidColorBrush x:Key="EditPanelBrush"   Color="{StaticResource EditPanelColor}"/>
  <SolidColorBrush x:Key="EditBorderBrush"  Color="{StaticResource EditBorderColor}"/>

  <!-- Scrim para diálogos modales -->
  <SolidColorBrush x:Key="ScrimBrush" Color="#1B1614" Opacity="0.55"/>

  <!-- ===================== Hover tokens ===================== -->
  <Color x:Key="AccentSoftHoverColor">#BDD9E8</Color>
  <Color x:Key="DangerHoverColor">#9E3226</Color>
  <Color x:Key="BgHoverColor">#E3DBC8</Color>

  <SolidColorBrush x:Key="AccentSoftHoverBrush" Color="{StaticResource AccentSoftHoverColor}"/>
  <SolidColorBrush x:Key="DangerHoverBrush"     Color="{StaticResource DangerHoverColor}"/>
  <SolidColorBrush x:Key="BgHoverBrush"         Color="{StaticResource BgHoverColor}"/>

  <!-- ===================== Button template compartido ===================== -->
  <!-- El hover brush se pasa a través de Tag, así el template es único. -->
  <ControlTemplate x:Key="AuroraButtonTemplate" TargetType="Button">
    <Border x:Name="Bd"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Padding="{TemplateBinding Padding}"
            CornerRadius="4">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background"
                Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <!-- ===================== Button styles ===================== -->
  <Style x:Key="BtnAccentStyle" TargetType="Button">
    <Setter Property="Background"   Value="{StaticResource AccentBrush}"/>
    <Setter Property="Foreground"   Value="{StaticResource FgOnAccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="Tag"          Value="{StaticResource AccentHoverBrush}"/>
    <Setter Property="Template"     Value="{StaticResource AuroraButtonTemplate}"/>
  </Style>

  <Style x:Key="BtnAccentSoftStyle" TargetType="Button">
    <Setter Property="Background"   Value="{StaticResource AccentSoftBrush}"/>
    <Setter Property="Foreground"   Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="Tag"          Value="{StaticResource AccentSoftHoverBrush}"/>
    <Setter Property="Template"     Value="{StaticResource AuroraButtonTemplate}"/>
  </Style>

  <Style x:Key="BtnDangerStyle" TargetType="Button">
    <Setter Property="Background"   Value="{StaticResource DangerBrush}"/>
    <Setter Property="Foreground"   Value="White"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="Tag"          Value="{StaticResource DangerHoverBrush}"/>
    <Setter Property="Template"     Value="{StaticResource AuroraButtonTemplate}"/>
  </Style>

  <Style x:Key="BtnCancelStyle" TargetType="Button">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource FgMutedBrush}"/>
    <Setter Property="BorderBrush"  Value="{StaticResource BorderStrongBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="Tag"          Value="{StaticResource BgHoverBrush}"/>
    <Setter Property="Template"     Value="{StaticResource AuroraButtonTemplate}"/>
  </Style>

  <Style x:Key="BtnIconStyle" TargetType="Button">
    <Setter Property="Background"   Value="Transparent"/>
    <Setter Property="Foreground"   Value="{StaticResource FgFaintBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor"       Value="Hand"/>
    <Setter Property="Tag"          Value="{StaticResource BgTileBrush}"/>
    <Setter Property="Template"     Value="{StaticResource AuroraButtonTemplate}"/>
  </Style>

  <!-- ===================== Thin ScrollBar (10 px, sin flechas, thumb redondeado) ===================== -->
  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
    <Setter Property="Width"    Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid x:Name="Root">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton OverridesDefaultStyle="True" Width="0" Height="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Rectangle/></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb OverridesDefaultStyle="True">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Background="{DynamicResource BorderStrongBrush}"
                              CornerRadius="5" Margin="2"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton OverridesDefaultStyle="True" Width="0" Height="0">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Rectangle/></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="Root"       Property="Width"              Value="Auto"/>
              <Setter TargetName="Root"       Property="Height"             Value="10"/>
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width"     Value="Auto"/>
        <Setter Property="Height"    Value="10"/>
        <Setter Property="MinWidth"  Value="0"/>
        <Setter Property="MinHeight" Value="10"/>
      </Trigger>
    </Style.Triggers>
  </Style>
    <!-- ===================== ComboBox Aurora ===================== -->
    <Style TargetType="ComboBox">
        <Setter Property="Background"       Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground"       Value="{StaticResource FgPrimaryBrush}"/>
        <Setter Property="BorderBrush"      Value="{StaticResource BorderInputBrush}"/>
        <Setter Property="BorderThickness"  Value="1"/>
        <Setter Property="Padding"          Value="8,6"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>

                                <ToggleButton Grid.Column="1"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen,
                                              RelativeSource={RelativeSource TemplatedParent},
                                              Mode=TwoWay}">
                                    <TextBlock Text="▾"
                                           FontSize="11"
                                           Foreground="{StaticResource FgMutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade"
                           Placement="Bottom">
                            <Border Background="{StaticResource BgElevBrush}"
                                BorderBrush="{StaticResource BorderInputBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="200"
                                Margin="0,2,0,0">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Items del ComboBox -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding"     Value="10,7"/>
        <Setter Property="Foreground"  Value="{StaticResource FgPrimaryBrush}"/>
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                Value="{StaticResource AccentSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                Value="{StaticResource AccentSoftBrush}"/>
                            <Setter Property="Foreground"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
