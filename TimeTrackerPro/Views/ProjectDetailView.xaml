<!-- Views/ProjectDetailView.xaml — reemplaza todo el contenido -->
<UserControl x:Class="TimeTrackerPro.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TimeTrackerPro.Helpers">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" Visibility="{Binding HasProject,
            Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- ===== CABECERA: modo lectura ===== -->
            <DockPanel Margin="0,0,0,24"
                       Visibility="{Binding IsEditingProject,
                           Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Button Content="✏ Editar"
                        DockPanel.Dock="Right"
                        Command="{Binding EditProjectCommand}"
                        Background="#EBF5FB" Foreground="#3498DB"
                        BorderThickness="0" Padding="12,6"
                        FontSize="12" Cursor="Hand"
                        VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="24" FontWeight="Light"
                               Foreground="#2C3E50"/>
                    <TextBlock Text="{Binding Project.Description}"
                               FontSize="13" Foreground="#95A5A6"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- ===== CABECERA: modo edición ===== -->
            <Border Background="#F0F7FF" CornerRadius="8" Padding="20"
                    Margin="0,0,0,24"
                    Visibility="{Binding IsEditingProject,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Editar proyecto" FontSize="14"
                               FontWeight="SemiBold" Foreground="#2C3E50"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Nombre *" FontSize="12"
                               Foreground="#6C757D" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditProjectName,
                                 UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,6" Height="36"
                             BorderBrush="#B8D4F0" BorderThickness="1"
                             AcceptsReturn="False"/>

                    <TextBlock Text="Descripción" FontSize="12"
                               Foreground="#6C757D" Margin="0,12,0,4"/>
                    <TextBox Text="{Binding EditProjectDescription}"
                             FontSize="13" Padding="8,6" Height="70"
                             BorderBrush="#B8D4F0" BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Horas por semana" FontSize="12"
                               Foreground="#6C757D" Margin="0,12,0,4"/>
                    <DockPanel>
                        <TextBlock Text="{Binding EditProjectWeeklyHours,
                                       StringFormat='{}{0}h'}"
                                   DockPanel.Dock="Right" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#3498DB"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="32"/>
                        <Slider Value="{Binding EditProjectWeeklyHours}"
                                Minimum="1" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Guardar"
                                Command="{Binding SaveProjectCommand}"
                                Background="#27AE60" Foreground="White"
                                BorderThickness="0" Padding="16,8"
                                FontSize="13" Cursor="Hand"/>
                        <Button Content="Cancelar"
                                Command="{Binding CancelEditProjectCommand}"
                                Background="Transparent" Foreground="#6C757D"
                                BorderBrush="#DEE2E6" BorderThickness="1"
                                Padding="16,8" FontSize="13"
                                Margin="8,0,0,0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== TARJETAS DE RESUMEN ===== -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#F8F9FA"
                        CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Estimadas"
                                   FontSize="11" Foreground="#ADB5BD"/>
                        <TextBlock Text="{Binding TotalEstimatedHours,
                                       StringFormat='{}{0:F1}h'}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#F8F9FA"
                        CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Trabajadas"
                                   FontSize="11" Foreground="#ADB5BD"/>
                        <TextBlock Text="{Binding TotalWorkedHours,
                                       StringFormat='{}{0:F1}h'}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="#3498DB" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#F8F9FA"
                        CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Fin estimado"
                                   FontSize="11" Foreground="#ADB5BD"/>
                        <TextBlock Text="{Binding EstimatedEndDate}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#F8F9FA"
                        CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Por semana"
                                   FontSize="11" Foreground="#ADB5BD"/>
                        <TextBlock Text="{Binding Project.WeeklyHours,
                                       StringFormat='{}{0}h'}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="#2C3E50" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== BARRA DE PROGRESO ===== -->
            <StackPanel Margin="0,0,0,28">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Progreso general"
                               FontSize="12" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding ProgressPercentage,
                                   StringFormat='{}{0:F0}%'}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#3498DB"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <Border Background="#E9ECEF" CornerRadius="4" Height="8">
                    <Border CornerRadius="4" Height="8"
                            HorizontalAlignment="Left"
                            Background="#3498DB">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                <Binding Path="ProgressPercentage"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=Border,
                                         AncestorLevel=2}" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </StackPanel>

            <!-- ===== CABECERA SECCIONES ===== -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Secciones" FontSize="15"
                           FontWeight="SemiBold" Foreground="#343A40"
                           VerticalAlignment="Center"/>
                <Button Content="＋ Sección"
                        Command="{Binding ShowAddSectionCommand}"
                        HorizontalAlignment="Right"
                        Background="#3498DB" Foreground="White"
                        BorderThickness="0" Padding="12,6"
                        FontSize="12" Cursor="Hand"/>
            </DockPanel>

            <!-- Error -->
            <Border Background="#FDECEA" Padding="12,8"
                    CornerRadius="6" Margin="0,0,0,12"
                    Visibility="{Binding HasError,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C0392B" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ===== FORMULARIO NUEVA SECCIÓN ===== -->
            <Border Background="#F0F7FF" CornerRadius="8"
                    Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding IsAddingSectionOrSub,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding NewSectionFormTitle}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="#2C3E50" Margin="0,0,0,12"/>

                    <TextBlock Text="Nombre *" FontSize="12"
                               Foreground="#6C757D" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewSectionName,
                                 UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="8,6" Height="36"
                             BorderBrush="#B8D4F0" BorderThickness="1"
                             AcceptsReturn="False"/>

                    <TextBlock Text="Horas estimadas" FontSize="12"
                               Foreground="#6C757D" Margin="0,12,0,4"/>
                    <DockPanel>
                        <TextBlock Text="{Binding NewSectionEstimatedHours,
                                       StringFormat='{}{0}h'}"
                                   DockPanel.Dock="Right" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#3498DB"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="32"/>
                        <Slider Value="{Binding NewSectionEstimatedHours}"
                                Minimum="0" Maximum="200"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Guardar"
                                Command="{Binding SaveSectionCommand}"
                                Background="#27AE60" Foreground="White"
                                BorderThickness="0" Padding="16,8"
                                FontSize="13" Cursor="Hand"/>
                        <Button Content="Cancelar"
                                Command="{Binding CancelSectionCommand}"
                                Background="Transparent" Foreground="#6C757D"
                                BorderBrush="#DEE2E6" BorderThickness="1"
                                Padding="16,8" FontSize="13"
                                Margin="8,0,0,0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== LISTA DE SECCIONES ===== -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" CornerRadius="8"
                                BorderBrush="#DEE2E6" BorderThickness="1"
                                Margin="0,0,0,8">
                            <StackPanel>

                                <!-- Modo LECTURA de la sección -->
                                <Border Padding="16,12">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource NotEqualToVisibilityConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.EditingSection"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                <DockPanel>

                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                        <Button Content="✏"
                                                Command="{Binding DataContext.EditSectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EBF5FB" Foreground="#3498DB"
                                                BorderThickness="0" Padding="8,4"
                                                FontSize="11" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Content="＋ Sub"
                                                Command="{Binding DataContext.ShowAddSubSectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="#EBF5FB" Foreground="#3498DB"
                                                BorderThickness="0" Padding="8,4"
                                                FontSize="11" Cursor="Hand" Margin="0,0,6,0"/>
                                        <Button Content="🗑"
                                                Command="{Binding DataContext.DeleteSectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#ADB5BD" FontSize="14" Cursor="Hand"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#212529"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock FontSize="12" Foreground="#6C757D">
                                                <Run Text="Sección: "/>
                                                <Run Text="{Binding TotalWorkedHours, Mode=OneWay,
                                                         StringFormat='{}{0:F1}h trabajadas'}"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding EstimatedHours, Mode=OneWay,
                                                         StringFormat='{}{0}h estimadas'}"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <Border Background="#E9ECEF" CornerRadius="3" Height="4"
                                                Margin="0,6,0,0" Width="200"
                                                HorizontalAlignment="Left">
                                            <Border CornerRadius="3" Height="4"
                                                    HorizontalAlignment="Left"
                                                    Background="#3498DB">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                        <Binding Path="CompletionPercentage"/>
                                                        <Binding Source="200"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                                </Border>

                                <!-- Modo EDICIÓN de la sección -->
                                <Border Padding="16,12" Background="#F0F7FF">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualToVisibilityConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.EditingSection"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <StackPanel>
                                        <TextBlock Text="Editar sección" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#2C3E50"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Nombre *" FontSize="12"
                                                   Foreground="#6C757D" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DataContext.EditSectionName,
                                                     UpdateSourceTrigger=PropertyChanged,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 FontSize="13" Padding="8,6" Height="36"
                                                 BorderBrush="#B8D4F0" BorderThickness="1"
                                                 AcceptsReturn="False"/>
                                        <TextBlock Text="Horas estimadas" FontSize="12"
                                                   Foreground="#6C757D" Margin="0,12,0,4"/>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DataContext.EditSectionEstimatedHours,
                                                           StringFormat='{}{0}h',
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       DockPanel.Dock="Right" FontSize="13"
                                                       FontWeight="SemiBold" Foreground="#3498DB"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <Slider Value="{Binding DataContext.EditSectionEstimatedHours,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Minimum="0" Maximum="200"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Guardar"
                                                    Command="{Binding DataContext.SaveSectionEditCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Background="#27AE60" Foreground="White"
                                                    BorderThickness="0" Padding="14,7"
                                                    FontSize="12" Cursor="Hand"/>
                                            <Button Content="Cancelar"
                                                    Command="{Binding DataContext.CancelEditSectionCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Background="Transparent" Foreground="#6C757D"
                                                    BorderBrush="#DEE2E6" BorderThickness="1"
                                                    Padding="14,7" FontSize="12"
                                                    Margin="8,0,0,0" Cursor="Hand"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===== SUBSECCIONES ===== -->
                                <ItemsControl ItemsSource="{Binding SubSections}"
                                              Margin="32,0,16,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8F9FA"
                                                    CornerRadius="6"
                                                    BorderBrush="#E9ECEF"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,4"
                                                    Padding="12,8">
                                                <StackPanel>

                                                    <!-- Modo LECTURA subsección -->
                                                    <DockPanel>
                                                        <DockPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource NotEqualToVisibilityConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.EditingSection"
                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DockPanel.Visibility>

                                                        <StackPanel DockPanel.Dock="Right"
                                                                    Orientation="Horizontal">
                                                            <Button Content="✏"
                                                                    Command="{Binding DataContext.EditSectionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" Foreground="#3498DB"
                                                                    BorderThickness="0" Padding="6,3"
                                                                    FontSize="11" Cursor="Hand" Margin="0,0,4,0"/>
                                                            <Button Content="🗑"
                                                                    Command="{Binding DataContext.DeleteSectionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Foreground="#ADB5BD" FontSize="12" Cursor="Hand"/>
                                                        </StackPanel>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13" Foreground="#495057"/>
                                                            <TextBlock FontSize="11" Foreground="#ADB5BD"
                                                                       Margin="0,2,0,0">
                                                                <Run Text="{Binding TotalWorkedHours, Mode=OneWay,
                                                                         StringFormat='{}{0:F1}h trabajadas'}"/>
                                                                <Run Text=" / "/>
                                                                <Run Text="{Binding EstimatedHours, Mode=OneWay,
                                                                         StringFormat='{}{0}h estimadas'}"/>
                                                            </TextBlock>
                                                            <Border Background="#E9ECEF" CornerRadius="3"
                                                                    Height="3" Margin="0,4,0,0"
                                                                    Width="160" HorizontalAlignment="Left">
                                                                <Border CornerRadius="3" Height="3"
                                                                        HorizontalAlignment="Left"
                                                                        Background="#85C1E9">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                                            <Binding Path="CompletionPercentage"/>
                                                                            <Binding Source="160"/>
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                </Border>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Modo EDICIÓN subsección -->
                                                    <Border Background="#F0F7FF"
                                                            CornerRadius="6" Padding="10">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource EqualToVisibilityConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.EditingSection"
                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                        <StackPanel>
                                                            <TextBlock Text="Editar subsección" FontSize="12"
                                                                       FontWeight="SemiBold" Foreground="#2C3E50"
                                                                       Margin="0,0,0,8"/>
                                                            <TextBox Text="{Binding DataContext.EditSectionName,
                                                                         UpdateSourceTrigger=PropertyChanged,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     FontSize="12" Padding="6,5" Height="32"
                                                                     BorderBrush="#B8D4F0" BorderThickness="1"
                                                                     AcceptsReturn="False"/>
                                                            <TextBlock Text="Horas estimadas" FontSize="11"
                                                                       Foreground="#6C757D" Margin="0,8,0,4"/>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding DataContext.EditSectionEstimatedHours,
                                                                               StringFormat='{}{0}h',
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           DockPanel.Dock="Right" FontSize="12"
                                                                           FontWeight="SemiBold" Foreground="#3498DB"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                <Slider Value="{Binding DataContext.EditSectionEstimatedHours,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Minimum="0" Maximum="200"
                                                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                            </DockPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                                <Button Content="Guardar"
                                                                        Command="{Binding DataContext.SaveSectionEditCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Background="#27AE60" Foreground="White"
                                                                        BorderThickness="0" Padding="12,6"
                                                                        FontSize="12" Cursor="Hand"/>
                                                                <Button Content="Cancelar"
                                                                        Command="{Binding DataContext.CancelEditSectionCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Background="Transparent" Foreground="#6C757D"
                                                                        BorderBrush="#DEE2E6" BorderThickness="1"
                                                                        Padding="12,6" FontSize="12"
                                                                        Margin="8,0,0,0" Cursor="Hand"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>