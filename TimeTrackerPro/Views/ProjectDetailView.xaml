<!-- Views/ProjectDetailView.xaml — versión tematizada con Aurora -->
<UserControl x:Class="TimeTrackerPro.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:TimeTrackerPro.Helpers"
             FontFamily="{DynamicResource UIFontFamily}"
             Background="{DynamicResource BgElevBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" Visibility="{Binding HasProject,
            Converter={StaticResource BoolToVisibilityConverter}}">

            <!-- ===== CABECERA: modo lectura ===== -->
            <DockPanel Margin="0,0,0,24"
                       Visibility="{Binding IsEditingProject,
                           Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Button Content="📄 Informe"
                        DockPanel.Dock="Right"
                        Command="{Binding GenerateReportCommand}"
                        Style="{StaticResource BtnAccentSoftStyle}"
                        Padding="12,6" FontSize="12"
                        VerticalAlignment="Top"
                        Margin="0,0,8,0"/>
                <Button Content="✏ Editar"
                        DockPanel.Dock="Right"
                        Command="{Binding EditProjectCommand}"
                        Style="{StaticResource BtnAccentSoftStyle}"
                        Padding="12,6" FontSize="12"
                        VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock Text="{Binding ProjectName}"
                               FontSize="26" FontWeight="Medium"
                               Foreground="{DynamicResource FgPrimaryBrush}"/>
                    <TextBlock Text="{Binding Project.Description}"
                               FontSize="13"
                               Foreground="{DynamicResource FgFaintBrush}"
                               Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- ===== CABECERA: modo edición ===== -->
            <Border Background="{DynamicResource EditPanelBrush}" CornerRadius="14" Padding="20"
                    Margin="0,0,0,24"
                    Visibility="{Binding IsEditingProject,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Editar proyecto" FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Nombre *" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditProjectName,
                                 UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="10,8" Height="36"
                             Background="{DynamicResource BgInputBrush}"
                             Foreground="{DynamicResource FgPrimaryBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             AcceptsReturn="False"/>

                    <TextBlock Text="Descripción" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,12,0,4"/>
                    <TextBox Text="{Binding EditProjectDescription}"
                             FontSize="13" Padding="10,8" Height="70"
                             Background="{DynamicResource BgInputBrush}"
                             Foreground="{DynamicResource FgPrimaryBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>

                    <TextBlock Text="Horas por semana" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,12,0,4"/>
                    <DockPanel>
                        <TextBlock Text="{Binding EditProjectWeeklyHours,
                                       StringFormat='{}{0}h'}"
                                   DockPanel.Dock="Right" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="32"/>
                        <Slider Value="{Binding EditProjectWeeklyHours}"
                                Minimum="1" Maximum="60"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <TextBlock Text="Fecha de entrega" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,12,0,4"/>
                    <DatePicker SelectedDate="{Binding EditProjectDeadline}"
                                FontSize="13" Height="30"
                                Background="{DynamicResource BgInputBrush}"
                                Foreground="{DynamicResource FgPrimaryBrush}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"/>

                    <TextBlock Text="Estado" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,12,0,4"/>
                    <ComboBox ItemsSource="{Binding ProjectStatuses}"
                              SelectedItem="{Binding EditProjectStatus}"
                              FontSize="13" Height="36"
                              Background="{DynamicResource BgInputBrush}"
                              Foreground="{DynamicResource FgPrimaryBrush}"
                              BorderBrush="{DynamicResource AccentBrush}"
                              BorderThickness="1"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Guardar"
                                Command="{Binding SaveProjectCommand}"
                                Style="{StaticResource BtnAccentStyle}"
                                Padding="16,8" FontSize="13" FontWeight="Medium"/>
                        <Button Content="Cancelar"
                                Command="{Binding CancelEditProjectCommand}"
                                Style="{StaticResource BtnCancelStyle}"
                                Padding="16,8" FontSize="13"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== TARJETAS DE RESUMEN ===== -->
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource BgTileBrush}"
                        CornerRadius="14" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Estimadas"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgFaintBrush}"/>
                        <TextBlock Text="{Binding TotalEstimatedHours,
                                       Converter={StaticResource HoursToTimeStringConverter}}"
                                   FontSize="24" FontWeight="Medium"
                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource BgTileBrush}"
                        CornerRadius="14" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Trabajadas"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgFaintBrush}"/>
                        <TextBlock Text="{Binding TotalWorkedHours,
                                       Converter={StaticResource HoursToTimeStringConverter}}"
                                   FontSize="24" FontWeight="Medium"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="{Binding Deviation.Level,
                            Converter={StaticResource DeviationToColorConverter}}"
                        CornerRadius="14" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Desviación"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgMutedBrush}"/>
                        <TextBlock Text="{Binding Deviation.Summary}"
                                   FontSize="12" FontWeight="Medium"
                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3"
                        Background="{DynamicResource BgTileBrush}"
                        CornerRadius="14" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Por semana"
                                   FontSize="11"
                                   Foreground="{DynamicResource FgFaintBrush}"/>
                        <TextBlock Text="{Binding Project.WeeklyHours,
                                       StringFormat='{}{0}h'}"
                                   FontSize="24" FontWeight="Medium"
                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== CRONÓMETRO ACTIVO (global) ===== -->
            <Border Background="{DynamicResource AccentSoftBrush}"
                    CornerRadius="12" Padding="16,10"
                    Margin="0,0,0,16"
                    Visibility="{Binding HasActiveTimer,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button Content="⏹ Detener"
                            DockPanel.Dock="Right"
                            Command="{Binding StopTimerCommand}"
                            Style="{StaticResource BtnDangerStyle}"
                            Padding="14,6"
                            FontSize="12" FontWeight="Medium"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cronómetro activo"
                                   FontSize="11"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding TimerDisplay}"
                                   FontSize="22" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ===== BARRA DE PROGRESO ===== -->
            <StackPanel Margin="0,0,0,28">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Progreso general"
                               FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"/>
                    <TextBlock Text="{Binding ProgressPercentage,
                                   StringFormat='{}{0:F0}%'}"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Right"/>
                </DockPanel>
                <Border Background="{DynamicResource BorderSoftBrush}" CornerRadius="6" Height="10">
                    <Border CornerRadius="6" Height="10"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentBrush}">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                <Binding Path="ProgressPercentage"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=Border,
                                         AncestorLevel=2}" Path="ActualWidth"/>
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </StackPanel>

            <!-- ===== CABECERA SECCIONES ===== -->
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="Secciones" FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource FgHeadingBrush}"
                           VerticalAlignment="Center"/>
                <Button Content="＋ Sección"
                        Command="{Binding ShowAddSectionCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource BtnAccentStyle}"
                        Padding="14,7"
                        FontSize="12" FontWeight="Medium"/>
            </DockPanel>

            <!-- Error -->
            <Border Background="{DynamicResource DangerSoftBrush}" Padding="12,8"
                    CornerRadius="10" Margin="0,0,0,12"
                    Visibility="{Binding HasError,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource DangerBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- ===== FORMULARIO NUEVA SECCIÓN ===== -->
            <Border Background="{DynamicResource EditPanelBrush}" CornerRadius="14"
                    Padding="20" Margin="0,0,0,16"
                    Visibility="{Binding IsAddingSectionOrSub,
                        Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding NewSectionFormTitle}"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource FgPrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Nombre *" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,0,0,4"/>
                    <TextBox Text="{Binding NewSectionName,
                                 UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13" Padding="10,8" Height="36"
                             Background="{DynamicResource BgInputBrush}"
                             Foreground="{DynamicResource FgPrimaryBrush}"
                             BorderBrush="{DynamicResource AccentBrush}"
                             BorderThickness="1"
                             AcceptsReturn="False"/>

                    <TextBlock Text="Horas estimadas" FontSize="12"
                               Foreground="{DynamicResource FgMutedBrush}"
                               Margin="0,12,0,4"/>
                    <DockPanel>
                        <TextBlock Text="{Binding NewSectionEstimatedHours,
                                       StringFormat='{}{0}h'}"
                                   DockPanel.Dock="Right" FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" MinWidth="32"/>
                        <Slider Value="{Binding NewSectionEstimatedHours}"
                                Minimum="0" Maximum="200"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Guardar"
                                Command="{Binding SaveSectionCommand}"
                                Style="{StaticResource BtnAccentStyle}"
                                Padding="16,8" FontSize="13" FontWeight="Medium"/>
                        <Button Content="Cancelar"
                                Command="{Binding CancelSectionCommand}"
                                Style="{StaticResource BtnCancelStyle}"
                                Padding="16,8" FontSize="13"
                                Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===== LISTA DE SECCIONES ===== -->
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgElevBrush}"
                                CornerRadius="14"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                Margin="0,0,0,10">
                            <StackPanel>

                                <!-- Modo LECTURA de la sección -->
                                <Border Padding="18,14">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource NotEqualToVisibilityConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.EditingSection"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                <DockPanel>

                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Top">
                                        <Button Content="✏"
                                                Command="{Binding DataContext.EditSectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BtnAccentSoftStyle}"
                                                Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="＋ Sub"
                                                Command="{Binding DataContext.ShowAddSubSectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BtnAccentSoftStyle}"
                                                Padding="8,4" FontSize="11" Margin="0,0,6,0"/>
                                        <!-- Botón INICIAR cronómetro (visible cuando esta sección NO está activa) -->
                                        <Button Content="▶"
                                                Command="{Binding DataContext.StartTimerCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsTimerActive,
                                                    Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                Style="{StaticResource BtnAccentSoftStyle}"
                                                Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                ToolTip="Iniciar cronómetro"/>

                                        <!-- Botón AÑADIR sesión manual -->
                                        <Button Content="＋ Sesión"
                                                Command="{Binding DataContext.AddManualSessionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BtnAccentSoftStyle}"
                                                Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                                ToolTip="Añadir sesión manual"/>

                                        <Button Content="🗑"
                                                Command="{Binding DataContext.DeleteSectionCommand,
                                                    RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BtnIconStyle}"
                                                FontSize="14"/>
                                    </StackPanel>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgPrimaryBrush}"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock FontSize="12"
                                                       Foreground="{DynamicResource FgMutedBrush}">
                                                <Run Text="Sección: "/>
                                                <Run Text="{Binding TotalWorkedHours, Mode=OneWay,
                                                         Converter={StaticResource HoursToTimeStringConverter}}"/>
                                                <Run Text=" trabajadas"/>
                                                <Run Text=" / "/>
                                                <Run Text="{Binding EstimatedHours, Mode=OneWay,
                                                         Converter={StaticResource HoursToTimeStringConverter}}"/>
                                                <Run Text=" estimadas"/>
                                            </TextBlock>
                                        </DockPanel>
                                        <Border Background="{DynamicResource BorderSoftBrush}" CornerRadius="3" Height="4"
                                                Margin="0,6,0,0" Width="220"
                                                HorizontalAlignment="Left">
                                            <Border CornerRadius="3" Height="4"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource AccentBrush}">
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                        <Binding Path="CompletionPercentage"/>
                                                        <Binding Source="220"/>
                                                    </MultiBinding>
                                                </Border.Width>
                                            </Border>
                                        </Border>

                                        <!-- Expander de sesiones de trabajo -->
                                        <Expander Header="{Binding WorkSessions.Count,
                                                           StringFormat='Sesiones ({0})'}"
                                                  Margin="0,8,0,0"
                                                  Foreground="{DynamicResource FgMutedBrush}"
                                                  FontSize="12">
                                            <ItemsControl ItemsSource="{Binding WorkSessions}"
                                                          Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BgTileBrush}"
                                                                CornerRadius="8" Padding="10,6"
                                                                Margin="0,0,0,4"
                                                                BorderBrush="{DynamicResource BorderSoftBrush}"
                                                                BorderThickness="1">
                                                            <DockPanel>
                                                                <!-- Botón borrar sesión -->
                                                                <Button Content="🗑"
                                                                        DockPanel.Dock="Right"
                                                                        Command="{Binding DataContext.DeleteSessionCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource BtnIconStyle}"
                                                                        FontSize="11"
                                                                        ToolTip="Eliminar sesión"/>
                                                                <StackPanel>
                                                                    <!-- Fecha y hora de inicio -->
                                                                    <TextBlock FontSize="11"
                                                                               Foreground="{DynamicResource FgMutedBrush}">
                                                                        <Run Text="{Binding StartTime,
                                                                                 StringFormat='dd/MM/yyyy  HH:mm',
                                                                                 Mode=OneWay}"/>
                                                                        <Run Text=" — "/>
                                                                        <Run Text="{Binding EndTime,
                                                                                 StringFormat='HH:mm',
                                                                                 Mode=OneWay}"/>
                                                                    </TextBlock>
                                                                    <!-- Duración -->
                                                                    <TextBlock FontSize="12" FontWeight="Medium"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               Margin="0,2,0,0">
                                                                        <Run Text="{Binding DurationHours,
                                                                                 Converter={StaticResource HoursToTimeStringConverter},
                                                                                 Mode=OneWay}"/>
                                                                        <Run Text=" "/>
                                                                        <!-- Indicador de sesión manual -->
                                                                        <Run Text="(manual)"
                                                                             Foreground="{DynamicResource FgFaintBrush}">
                                                                            <Run.Style>
                                                                                <Style TargetType="Run">
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsManual}" Value="False">
                                                                                            <Setter Property="Text" Value=""/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </Run.Style>
                                                                        </Run>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </StackPanel>
                                </DockPanel>
                                </Border>

                                <!-- Modo EDICIÓN de la sección -->
                                <Border Padding="18,14"
                                        Background="{DynamicResource EditPanelBrush}">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource EqualToVisibilityConverter}">
                                            <Binding/>
                                            <Binding Path="DataContext.EditingSection"
                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <StackPanel>
                                        <TextBlock Text="Editar sección" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource FgPrimaryBrush}"
                                                   Margin="0,0,0,10"/>
                                        <TextBlock Text="Nombre *" FontSize="12"
                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding DataContext.EditSectionName,
                                                     UpdateSourceTrigger=PropertyChanged,
                                                     RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                 FontSize="13" Padding="10,8" Height="36"
                                                 Background="{DynamicResource BgInputBrush}"
                                                 Foreground="{DynamicResource FgPrimaryBrush}"
                                                 BorderBrush="{DynamicResource AccentBrush}"
                                                 BorderThickness="1"
                                                 AcceptsReturn="False"/>
                                        <TextBlock Text="Horas estimadas" FontSize="12"
                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                   Margin="0,12,0,4"/>
                                        <DockPanel>
                                            <TextBlock Text="{Binding DataContext.EditSectionEstimatedHours,
                                                           StringFormat='{}{0}h',
                                                           RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       DockPanel.Dock="Right" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                                            <Slider Value="{Binding DataContext.EditSectionEstimatedHours,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Minimum="0" Maximum="200"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        </DockPanel>
                                        <TextBlock Text="Fecha de entrega" FontSize="12"
                                                   Foreground="{DynamicResource FgMutedBrush}"
                                                   Margin="0,12,0,4"/>
                                        <DatePicker SelectedDate="{Binding DataContext.EditSectionDeadline,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    FontSize="13" Height="30"
                                                    Background="{DynamicResource BgInputBrush}"
                                                    Foreground="{DynamicResource FgPrimaryBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"/>

                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Content="Guardar"
                                                    Command="{Binding DataContext.SaveSectionEditCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource BtnAccentStyle}"
                                                    Padding="14,7" FontSize="12" FontWeight="Medium"/>
                                            <Button Content="Cancelar"
                                                    Command="{Binding DataContext.CancelEditSectionCommand,
                                                        RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource BtnCancelStyle}"
                                                    Padding="14,7" FontSize="12"
                                                    Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ===== SUBSECCIONES ===== -->
                                <ItemsControl ItemsSource="{Binding SubSections}"
                                              Margin="32,0,16,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgTileBrush}"
                                                    CornerRadius="10"
                                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                                    BorderThickness="1"
                                                    Margin="0,0,0,4"
                                                    Padding="12,8">
                                                <StackPanel>

                                                    <!-- Modo LECTURA subsección -->
                                                    <DockPanel>
                                                        <DockPanel.Visibility>
                                                            <MultiBinding Converter="{StaticResource NotEqualToVisibilityConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.EditingSection"
                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </DockPanel.Visibility>

                                                        <StackPanel DockPanel.Dock="Right"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Top">
                                                            <Button Content="✏"
                                                                    Command="{Binding DataContext.EditSectionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource BtnIconStyle}"
                                                                    Foreground="{DynamicResource AccentBrush}"
                                                                    Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                                                            <Button Content="▶"
                                                                    Command="{Binding DataContext.StartTimerCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Visibility="{Binding IsTimerActive,
                                                                        Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                                    Style="{StaticResource BtnAccentSoftStyle}"
                                                                    Padding="6,3" FontSize="11" Margin="0,0,4,0"
                                                                    ToolTip="Iniciar cronómetro"/>
                                                            <Button Content="＋ Sesión"
                                                                    Command="{Binding DataContext.AddManualSessionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource BtnAccentSoftStyle}"
                                                                    Padding="6,3" FontSize="11" Margin="0,0,4,0"
                                                                    ToolTip="Añadir sesión manual"/>
                                                            <Button Content="🗑"
                                                                    Command="{Binding DataContext.DeleteSectionCommand,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource BtnIconStyle}"
                                                                    FontSize="12"/>
                                                        </StackPanel>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource FgHeadingBrush}"/>
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource FgFaintBrush}"
                                                                       Margin="0,2,0,0">
                                                                <Run Text="{Binding TotalWorkedHours, Mode=OneWay,
                                                                         Converter={StaticResource HoursToTimeStringConverter}}"/>
                                                                <Run Text=" trabajadas"/>
                                                                <Run Text=" / "/>
                                                                <Run Text="{Binding EstimatedHours, Mode=OneWay,
                                                                         Converter={StaticResource HoursToTimeStringConverter}}"/>
                                                                <Run Text=" estimadas"/>
                                                            </TextBlock>
                                                            <Border Background="{DynamicResource BorderSoftBrush}" CornerRadius="3"
                                                                    Height="3" Margin="0,4,0,0"
                                                                    Width="160" HorizontalAlignment="Left">
                                                                <Border CornerRadius="3" Height="3"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource AccentSubBrush}">
                                                                    <Border.Width>
                                                                        <MultiBinding Converter="{StaticResource PercentageToWidthConverter}">
                                                                            <Binding Path="CompletionPercentage"/>
                                                                            <Binding Source="160"/>
                                                                        </MultiBinding>
                                                                    </Border.Width>
                                                                </Border>
                                                            </Border>

                                                            <!-- Expander de sesiones de trabajo -->
                                                            <Expander Header="{Binding WorkSessions.Count,
                                                                               StringFormat='Sesiones ({0})'}"
                                                                      Margin="0,6,0,0"
                                                                      Foreground="{DynamicResource FgMutedBrush}"
                                                                      FontSize="11">
                                                                <ItemsControl ItemsSource="{Binding WorkSessions}"
                                                                              Margin="0,4,0,0">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{DynamicResource BgTileBrush}"
                                                                                    CornerRadius="6" Padding="8,5"
                                                                                    Margin="0,0,0,3"
                                                                                    BorderBrush="{DynamicResource BorderSoftBrush}"
                                                                                    BorderThickness="1">
                                                                                <DockPanel>
                                                                                    <Button Content="🗑"
                                                                                            DockPanel.Dock="Right"
                                                                                            Command="{Binding DataContext.DeleteSessionCommand,
                                                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                            CommandParameter="{Binding}"
                                                                                            Style="{StaticResource BtnIconStyle}"
                                                                                            FontSize="10"
                                                                                            ToolTip="Eliminar sesión"/>
                                                                                    <StackPanel>
                                                                                        <TextBlock FontSize="10"
                                                                                                   Foreground="{DynamicResource FgMutedBrush}">
                                                                                            <Run Text="{Binding StartTime,
                                                                                                     StringFormat='dd/MM/yyyy  HH:mm',
                                                                                                     Mode=OneWay}"/>
                                                                                            <Run Text=" — "/>
                                                                                            <Run Text="{Binding EndTime,
                                                                                                     StringFormat='HH:mm',
                                                                                                     Mode=OneWay}"/>
                                                                                        </TextBlock>
                                                                                        <TextBlock FontSize="11" FontWeight="Medium"
                                                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                                                   Margin="0,1,0,0">
                                                                                            <Run Text="{Binding DurationHours,
                                                                                                     Converter={StaticResource HoursToTimeStringConverter},
                                                                                                     Mode=OneWay}"/>
                                                                                            <Run Text=" "/>
                                                                                            <Run Text="(manual)"
                                                                                                 Foreground="{DynamicResource FgFaintBrush}">
                                                                                                <Run.Style>
                                                                                                    <Style TargetType="Run">
                                                                                                        <Style.Triggers>
                                                                                                            <DataTrigger Binding="{Binding IsManual}" Value="False">
                                                                                                                <Setter Property="Text" Value=""/>
                                                                                                            </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                    </Style>
                                                                                                </Run.Style>
                                                                                            </Run>
                                                                                        </TextBlock>
                                                                                    </StackPanel>
                                                                                </DockPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!-- Modo EDICIÓN subsección -->
                                                    <Border Background="{DynamicResource EditPanelBrush}"
                                                            CornerRadius="10" Padding="10">
                                                        <Border.Visibility>
                                                            <MultiBinding Converter="{StaticResource EqualToVisibilityConverter}">
                                                                <Binding/>
                                                                <Binding Path="DataContext.EditingSection"
                                                                         RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            </MultiBinding>
                                                        </Border.Visibility>
                                                        <StackPanel>
                                                            <TextBlock Text="Editar subsección" FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource FgPrimaryBrush}"
                                                                       Margin="0,0,0,8"/>
                                                            <TextBox Text="{Binding DataContext.EditSectionName,
                                                                         UpdateSourceTrigger=PropertyChanged,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     FontSize="12" Padding="6,5" Height="32"
                                                                     Background="{DynamicResource BgInputBrush}"
                                                                     Foreground="{DynamicResource FgPrimaryBrush}"
                                                                     BorderBrush="{DynamicResource AccentBrush}"
                                                                     BorderThickness="1"
                                                                     AcceptsReturn="False"/>
                                                            <TextBlock Text="Horas estimadas" FontSize="11"
                                                                       Foreground="{DynamicResource FgMutedBrush}"
                                                                       Margin="0,8,0,4"/>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding DataContext.EditSectionEstimatedHours,
                                                                               StringFormat='{}{0}h',
                                                                               RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                           DockPanel.Dock="Right" FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                                                                <Slider Value="{Binding DataContext.EditSectionEstimatedHours,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Minimum="0" Maximum="200"
                                                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                                                            </DockPanel>
                                                            <TextBlock Text="Fecha de entrega" FontSize="11"
                                                                       Foreground="{DynamicResource FgMutedBrush}"
                                                                       Margin="0,8,0,4"/>
                                                            <DatePicker SelectedDate="{Binding DataContext.EditSectionDeadline,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        FontSize="12" Height="28"
                                                                        Background="{DynamicResource BgInputBrush}"
                                                                        Foreground="{DynamicResource FgPrimaryBrush}"
                                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                                        BorderThickness="1"/>

                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                                <Button Content="Guardar"
                                                                        Command="{Binding DataContext.SaveSectionEditCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Style="{StaticResource BtnAccentStyle}"
                                                                        Padding="12,6" FontSize="12" FontWeight="Medium"/>
                                                                <Button Content="Cancelar"
                                                                        Command="{Binding DataContext.CancelEditSectionCommand,
                                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Style="{StaticResource BtnCancelStyle}"
                                                                        Padding="12,6" FontSize="12"
                                                                        Margin="8,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
