<!-- Views/ConfirmDialog.xaml — reemplaza todo el contenido -->
<Window x:Class="TimeTrackerPro.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Fondo oscuro semitransparente que simula un overlay modal -->
    <Border Background="#CC000000" Padding="5">
        <Border Background="White" CornerRadius="12"
                MinWidth="400" MaxWidth="480"
                Padding="32">
            <StackPanel>

                <!-- Icono y título -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#FFF3CD" Width="40" Height="40"
                            CornerRadius="20">
                        <TextBlock Text="⚠" FontSize="18"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="#212529" Margin="14,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Mensaje -->
                <TextBlock x:Name="MessageText"
                           FontSize="14" Foreground="#6C757D"
                           TextWrapping="Wrap" LineHeight="22"
                           Margin="0,0,0,28"/>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            Click="OnCancelClick"
                            Background="Transparent"
                            Foreground="#6C757D"
                            BorderBrush="#DEE2E6"
                            BorderThickness="1"
                            Padding="20,10"
                            FontSize="13"
                            Cursor="Hand"/>
                    <Button x:Name="ConfirmButton"
                            Click="OnConfirmClick"
                            Background="#E74C3C"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="20,10"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="10,0,0,0"
                            Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>
</Window>
