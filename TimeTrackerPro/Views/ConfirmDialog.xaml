<!-- Views/ConfirmDialog.xaml — versión tematizada con Aurora -->
<Window x:Class="TimeTrackerPro.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="{DynamicResource UIFontFamily}">

    <!-- Scrim oscuro semitransparente -->
    <Border Background="{DynamicResource ScrimBrush}" Padding="5">
        <Border Background="{DynamicResource BgElevBrush}" CornerRadius="20"
                MinWidth="420" MaxWidth="500"
                BorderBrush="{DynamicResource BorderColorBrush}"
                BorderThickness="1"
                Padding="32">
            <Border.Effect>
                <DropShadowEffect Color="#1B1614" Opacity="0.30" BlurRadius="40" ShadowDepth="12"/>
            </Border.Effect>
            <StackPanel>

                <!-- Icono centrado arriba -->
                <Border Background="{DynamicResource DangerSoftBrush}"
                        Width="56" Height="56"
                        CornerRadius="28"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,16">
                    <TextBlock Text="⚠" FontSize="26"
                               Foreground="{DynamicResource DangerBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Título centrado -->
                <TextBlock x:Name="TitleText"
                           FontSize="20" FontWeight="Medium"
                           Foreground="{DynamicResource FgPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <!-- Mensaje -->
                <TextBlock x:Name="MessageText"
                           FontSize="14"
                           Foreground="{DynamicResource FgMutedBrush}"
                           TextWrapping="Wrap" LineHeight="22"
                           TextAlignment="Center"
                           Margin="0,0,0,28"/>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button x:Name="CancelButton"
                            Content="Cancelar"
                            Click="OnCancelClick"
                            Background="Transparent"
                            Foreground="{DynamicResource FgMutedBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1"
                            Padding="22,11"
                            FontSize="13"
                            FontWeight="Medium"
                            Cursor="Hand"/>
                    <Button x:Name="ConfirmButton"
                            Click="OnConfirmClick"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="22,11"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Margin="10,0,0,0"
                            Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>
</Window>
