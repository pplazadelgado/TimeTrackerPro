<Window x:Class="TimeTrackerPro.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="360" Height="210"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#1B1614" CornerRadius="14">
        <!-- teal top accent bar -->
        <Border.Clip>
            <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,360,210"/>
        </Border.Clip>

        <Grid>
            <Rectangle Height="4" VerticalAlignment="Top" Fill="#146C94"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="40,24,40,28">

                <TextBlock Text="⏱"
                           FontSize="34"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>

                <TextBlock Text="TimeTracker Pro"
                           FontSize="22" FontWeight="SemiBold"
                           Foreground="#FBF7EC"
                           HorizontalAlignment="Center"
                           FontFamily="pack://application:,,,/Assets/Fonts/#Space Grotesk"/>

                <TextBlock x:Name="StatusText"
                           Text="Iniciando..."
                           FontSize="12"
                           Foreground="#978E80"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,18"
                           FontFamily="pack://application:,,,/Assets/Fonts/#Space Grotesk"/>

                <!-- custom indeterminate progress bar -->
                <Border Height="4" Background="#2E2725" CornerRadius="2" ClipToBounds="True">
                    <Rectangle x:Name="ProgressRect" Width="80" Fill="#146C94"
                               RadiusX="2" RadiusY="2"
                               HorizontalAlignment="Left">
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <ThicknessAnimation
                                            Storyboard.TargetProperty="Margin"
                                            From="-80,0,0,0" To="360,0,0,0"
                                            Duration="0:0:1.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</Window>
