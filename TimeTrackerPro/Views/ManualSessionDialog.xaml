<!-- Views/ManualSessionDialog.xaml -->
<Window x:Class="TimeTrackerPro.Views.ManualSessionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border Background="#CC000000" Padding="60">
        <Border Background="White" CornerRadius="12"
                MinWidth="420" Padding="32">
            <StackPanel>

                <TextBlock x:Name="TitleText"
                           FontSize="17" FontWeight="SemiBold"
                           Foreground="#212529" Margin="0,0,0,24"/>

                <!-- Fecha -->
                <TextBlock Text="Fecha" FontSize="12"
                           Foreground="#6C757D" Margin="0,0,0,4"/>
                <DatePicker x:Name="DatePicker"
                            FontSize="13" Padding="8,6"
                            BorderBrush="#DEE2E6"/>

                <!-- Hora inicio -->
                <TextBlock Text="Hora de inicio (HH:mm)"
                           FontSize="12" Foreground="#6C757D"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="StartTimeBox"
                         FontSize="13" Padding="8,6" Height="36"
                         Background="{DynamicResource BgInputBrush}"
                         BorderBrush="{DynamicResource BorderInputBrush}"
                         Foreground="{DynamicResource FgPrimaryBrush}"
                         BorderThickness="1"
                         Text="09:00"/>

                <!-- Hora fin -->
                <TextBlock Text="Hora de fin (HH:mm)"
                           FontSize="12" Foreground="#6C757D"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="EndTimeBox"
                         FontSize="13" Padding="8,6" Height="36"
                         Background="{DynamicResource BgInputBrush}"
                         BorderBrush="{DynamicResource BorderInputBrush}"
                         Foreground="{DynamicResource FgPrimaryBrush}"
                         BorderThickness="1"
                         Text="10:00"/>

                <!-- Notas -->
                <TextBlock Text="Notas (opcional)"
                           FontSize="12" Foreground="#6C757D"
                           Margin="0,12,0,4"/>
                <TextBox x:Name="NotesBox"
                         FontSize="13" Padding="8,6" Height="70"
                         Background="{DynamicResource BgInputBrush}"
                         BorderBrush="{DynamicResource BorderInputBrush}"
                         Foreground="{DynamicResource FgPrimaryBrush}"
                         BorderThickness="1"
                         TextWrapping="Wrap" AcceptsReturn="True"/>

                <!-- Error -->
                <TextBlock x:Name="ErrorText"
                           Foreground="#C0392B" FontSize="12"
                           Margin="0,8,0,0" Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">
                    <Button Content="Cancelar"
                            Click="OnCancelClick"
                            Background="Transparent" Foreground="#6C757D"
                            BorderBrush="#DEE2E6" BorderThickness="1"
                            Padding="20,10" FontSize="13" Cursor="Hand"/>
                    <Button Content="Guardar sesión"
                            Click="OnSaveClick"
                            Background="#27AE60" Foreground="White"
                            BorderThickness="0" Padding="20,10"
                            FontSize="13" Margin="10,0,0,0" Cursor="Hand"/>
                </StackPanel>

            </StackPanel>
        </Border>
    </Border>
</Window>
