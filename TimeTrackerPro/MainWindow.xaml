<!-- MainWindow.xaml — versión tematizada con Aurora -->
<Window x:Class="TimeTrackerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimeTrackerPro.ViewModels"
        xmlns:views="clr-namespace:TimeTrackerPro.Views"
        Title="TimeTracker Pro"
        Icon="Assets/app-icon.ico"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        FontFamily="{DynamicResource UIFontFamily}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <Window.DataContext>
        <vm:ProjectListViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== CABECERA ===== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" Padding="24,0">
            <DockPanel>
                <TextBlock Text="⏱ TimeTracker Pro"
                           Foreground="{DynamicResource FgOnDarkBrush}"
                           FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <!-- Toggle claro/oscuro -->
                <Button x:Name="ThemeToggleBtn"
                        DockPanel.Dock="Right"
                        Content="🌙"
                        Click="OnThemeToggle"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontSize="16"
                        Padding="6,0"
                        Foreground="{DynamicResource FgOnDarkBrush}"
                        VerticalAlignment="Center"
                        ToolTip="Cambiar tema"/>
                <!-- Indicador de carga -->
                <TextBlock Text="Cargando..."
                           Foreground="{DynamicResource FgOnDarkMutedBrush}"
                           FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding IsLoading,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL: dos columnas ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== COLUMNA IZQUIERDA: lista ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Cabecera de la lista -->
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="Proyectos" FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource FgHeadingBrush}"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋ Nuevo"
                                    Command="{Binding ShowNewProjectFormCommand}"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource BtnAccentStyle}"
                                    Padding="12,6" FontSize="12"/>
                        </DockPanel>
                    </Border>

                    <!-- Mensaje de error -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource DangerSoftBrush}"
                            Padding="12,8"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{DynamicResource DangerBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Lista de proyectos -->
                    <ListBox ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject}"
                             Background="Transparent" BorderThickness="0"
                             Padding="8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,2"
                                        CornerRadius="10"
                                        BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background"   Value="{DynamicResource BgElevBrush}"/>
                                            <Setter Property="BorderBrush"  Value="{DynamicResource BorderColorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected,
                                                    RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    Value="True">
                                                    <Setter Property="Background"  Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMouseOver,
                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            Value="True"/>
                                                        <Condition Binding="{Binding IsSelected,
                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                            Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <Button Content="🗑"
                                                DockPanel.Dock="Right"
                                                Command="{Binding DataContext.DeleteProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource BtnIconStyle}"
                                                FontSize="14"
                                                VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                                            <TextBlock Text="{Binding WeeklyHours,
                                                           StringFormat='{}{0}h/semana'}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource FgMutedBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== COLUMNA DERECHA: formulario o bienvenida ===== -->
            <Grid Grid.Column="1" Background="{DynamicResource BgElevBrush}">

                <!-- Detalle del proyecto seleccionado -->
                <views:ProjectDetailView
                    DataContext="{Binding DetailViewModel}"
                    Visibility="{Binding DetailViewModel.HasProject,
                        Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Formulario nuevo proyecto -->
                <Border Padding="40"
                        Visibility="{Binding IsFormVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock Text="Nuevo proyecto"
                                       FontSize="26" FontWeight="Medium"
                                       Foreground="{DynamicResource FgPrimaryBrush}"
                                       Margin="0,0,0,28"/>

                            <TextBlock Text="Nombre *" FontSize="12"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="14" Padding="12,10"
                                     Background="{DynamicResource BgInputBrush}"
                                     BorderBrush="{DynamicResource BorderInputBrush}"
                                     Foreground="{DynamicResource FgPrimaryBrush}"
                                     BorderThickness="1"
                                     Height="40"
                                     AcceptsReturn="False"
                                     TextWrapping="NoWrap"/>

                            <TextBlock Text="Descripción" FontSize="12"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       Margin="0,16,0,4"/>
                            <TextBox Text="{Binding NewProjectDescription,
                                     UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="13" Padding="12,10"
                                     Background="{DynamicResource BgInputBrush}"
                                     BorderBrush="{DynamicResource BorderInputBrush}"
                                     Foreground="{DynamicResource FgPrimaryBrush}"
                                     BorderThickness="1"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="80" Width="480" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Horas semanales disponibles"
                                       FontSize="12"
                                       Foreground="{DynamicResource FgMutedBrush}"
                                       Margin="0,16,0,4"/>
                            <DockPanel>
                                <TextBlock Text="{Binding NewProjectWeeklyHours,
                                           StringFormat='{}{0}h'}"
                                           DockPanel.Dock="Right"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" MinWidth="40"/>
                                <Slider Value="{Binding NewProjectWeeklyHours}"
                                        Minimum="1" Maximum="80"
                                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                                <Button Content="Guardar proyecto"
                                        Command="{Binding SaveNewProjectCommand}"
                                        Style="{StaticResource BtnAccentStyle}"
                                        Padding="20,10"
                                        FontSize="14" FontWeight="Medium"/>
                                <Button Content="Cancelar"
                                        Command="{Binding CancelNewProjectCommand}"
                                        Style="{StaticResource BtnCancelStyle}"
                                        Padding="20,10" FontSize="14"
                                        Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Pantalla bienvenida -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowWelcome,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Selecciona un proyecto"
                               FontSize="22" FontWeight="Medium"
                               Foreground="{DynamicResource FgFaintBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="o crea uno nuevo con el botón ＋"
                               FontSize="14"
                               Foreground="{DynamicResource FgFaintBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
