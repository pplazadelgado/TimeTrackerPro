<!-- MainWindow.xaml — reemplaza todo el contenido -->
<Window x:Class="TimeTrackerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TimeTrackerPro.ViewModels"
        xmlns:views="clr-namespace:TimeTrackerPro.Views"
        Title="TimeTracker Pro"
        Height="700" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:ProjectListViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== CABECERA ===== -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="24,0">
            <DockPanel>
                <TextBlock Text="⏱ TimeTracker Pro"
                           Foreground="White" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <!-- Indicador de carga -->
                <TextBlock Text="Cargando..."
                           Foreground="#BDC3C7" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Visibility="{Binding IsLoading,
                               Converter={StaticResource BoolToVisibilityConverter}}"/>
            </DockPanel>
        </Border>

        <!-- ===== CONTENIDO PRINCIPAL: dos columnas ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <!-- Lista de proyectos -->
                <ColumnDefinition Width="*"/>
                <!-- Panel derecho -->
            </Grid.ColumnDefinitions>

            <!-- ===== COLUMNA IZQUIERDA: lista ===== -->
            <Border Grid.Column="0" Background="#F8F9FA"
                    BorderBrush="#DEE2E6" BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Cabecera de la lista -->
                    <Border DockPanel.Dock="Top" Padding="16,12"
                            BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="Proyectos" FontSize="15"
                                       FontWeight="SemiBold" Foreground="#343A40"
                                       VerticalAlignment="Center"/>
                            <Button Content="＋ Nuevo"
                                    Command="{Binding ShowNewProjectFormCommand}"
                                    HorizontalAlignment="Right"
                                    Background="#3498DB" Foreground="White"
                                    BorderThickness="0" Padding="12,6"
                                    FontSize="12" Cursor="Hand"/>
                        </DockPanel>
                    </Border>

                    <!-- Mensaje de error -->
                    <Border DockPanel.Dock="Top"
                            Background="#FDECEA" Padding="12,8"
                            Visibility="{Binding HasError,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#C0392B" FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- Lista de proyectos -->
                    <ListBox ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject}"
                             Background="Transparent" BorderThickness="0"
                             Padding="8">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,2"
                                        Background="White" CornerRadius="6"
                                        BorderBrush="#DEE2E6" BorderThickness="1">
                                    <DockPanel>
                                        <!-- Botón borrar -->
                                        <Button Content="🗑"
                                                DockPanel.Dock="Right"
                                                Command="{Binding DataContext.DeleteProjectCommand,
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="#ADB5BD"
                                                FontSize="14" Cursor="Hand"
                                                VerticalAlignment="Top"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Foreground="#212529"/>
                                            <TextBlock Text="{Binding WeeklyHours,
                                                           StringFormat='{}{0}h/semana'}"
                                                       FontSize="11"
                                                       Foreground="#6C757D"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== COLUMNA DERECHA: formulario o bienvenida ===== -->
            <Grid Grid.Column="1" Background="White">

                <!-- Detalle del proyecto seleccionado -->
                <views:ProjectDetailView
                    DataContext="{Binding DetailViewModel}"
                    Visibility="{Binding HasProject,
                        Converter={StaticResource BoolToVisibilityConverter}}"/>    

                <!-- Formulario nuevo proyecto -->
                <Border Padding="40"
                        Visibility="{Binding IsFormVisible,
                            Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                        <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                            <TextBlock Text="Nuevo proyecto"
                                   FontSize="22" FontWeight="Light"
                                   Foreground="#2C3E50" Margin="0,0,0,28"/>

                            <TextBlock Text="Nombre *" FontSize="12"
                                   Foreground="#6C757D" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="14" Padding="10,8"
                                 BorderBrush="#DEE2E6" BorderThickness="1"
                                 Height="38"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"/>

                            <TextBlock Text="Descripción" FontSize="12"
                                   Foreground="#6C757D" Margin="0,16,0,4"/>
                            <TextBox Text="{Binding NewProjectDescription,
                                     UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="10,8"
                                 BorderBrush="#DEE2E6" BorderThickness="1"
                                 TextWrapping="NoWrap" AcceptsReturn="True"
                                 Height="80" Width="480" VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Horas semanales disponibles"
                                   FontSize="12" Foreground="#6C757D"
                                   Margin="0,16,0,4"/>
                            <DockPanel>
                                <TextBlock Text="{Binding NewProjectWeeklyHours,
                                           StringFormat='{}{0}h'}"
                                       DockPanel.Dock="Right"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="#3498DB"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" MinWidth="40"/>
                                <Slider Value="{Binding NewProjectWeeklyHours}"
                                    Minimum="1" Maximum="80"
                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                            </DockPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                                <Button Content="Guardar proyecto"
                                    Command="{Binding SaveNewProjectCommand}"
                                    Background="#27AE60" Foreground="White"
                                    BorderThickness="0" Padding="20,10"
                                    FontSize="14" Cursor="Hand"/>
                                <Button Content="Cancelar"
                                    Command="{Binding CancelNewProjectCommand}"
                                    Background="Transparent"
                                    Foreground="#6C757D"
                                    BorderBrush="#DEE2E6" BorderThickness="1"
                                    Padding="20,10" FontSize="14"
                                    Margin="12,0,0,0" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Pantalla bienvenida -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding ShowWelcome,
                                Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Selecciona un proyecto"
                               FontSize="22" FontWeight="Light"
                               Foreground="#ADB5BD" HorizontalAlignment="Center"/>
                    <TextBlock Text="o crea uno nuevo con el botón ＋"
                               FontSize="14" Foreground="#CED4DA"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>